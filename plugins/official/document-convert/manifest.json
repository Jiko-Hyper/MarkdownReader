{
  "id": "mdreader.document-convert",
  "name": "文档格式转换",
  "version": "1.4.0",
  "api_version": "1",
  "app_version_range": ">=0.4.11",
  "entrypoint": "plugin.py",
  "capabilities": [
    "file.convert"
  ],
  "dependencies": [],
  "publisher": "MDReader",
  "description": "离线图片文字识别、PDF / Word 转 Markdown、Markdown 与 HTML 互转。",
  "commands": [
    {
      "id": "scan-md",
      "title": "扫描 PDF 转 Markdown（公式与原页批注）",
      "method": "scan_to_md",
      "capability": "file.convert",
      "format": "scan-md",
      "extension": "md",
      "media_type": "text/markdown"
    },
    {
      "id": "image-md",
      "title": "图片转 Markdown（离线文字识别）",
      "method": "image_to_md",
      "capability": "file.convert",
      "format": "image-md",
      "extension": "md",
      "media_type": "text/markdown"
    },
    {
      "id": "photo-md",
      "title": "纸质照片转 Markdown（增强识别）",
      "method": "photo_to_md",
      "capability": "file.convert",
      "format": "photo-md",
      "extension": "md",
      "media_type": "text/markdown"
    },
    {
      "id": "pdf-md",
      "title": "PDF 转 Markdown",
      "method": "pdf_to_md",
      "capability": "file.convert",
      "format": "pdf-md",
      "extension": "md",
      "media_type": "text/markdown"
    },
    {
      "id": "docx-md",
      "title": "Word 转 Markdown（DOCX）",
      "method": "word_to_md",
      "capability": "file.convert",
      "format": "docx-md",
      "extension": "md",
      "media_type": "text/markdown"
    },
    {
      "id": "md-html",
      "title": "Markdown 转 HTML",
      "method": "md_to_html",
      "capability": "file.convert",
      "format": "md-html",
      "extension": "html",
      "media_type": "text/html"
    },
    {
      "id": "html-md",
      "title": "HTML 转 Markdown",
      "method": "html_to_md",
      "capability": "file.convert",
      "format": "html-md",
      "extension": "md",
      "media_type": "text/markdown"
    }
  ]
}